{
"version": 1,
"dialogs": [
{
"id": "d01",
"title": "Saludar a un vecino",
"place": "En la escalera",
"other": "Vecino",
"lvl": 1,
"lines": [
{
"w": "o",
"es": "Hola",
"pr": "salamu 3alikum!",
"ar": "السلام عليكم!"
},
{
"w": "t",
"es": "¡Hola! ¿Qué tal?",
"pr": "wa 3alikum salam! labas?",
"ar": "وعليكم السلام! لاباس؟"
},
{
"w": "o",
"es": "Bien, gracias a Dios. ¿Y tú, cómo estás?",
"pr": "labas, l-7amdulillah. u nta, kidayr?",
"ar": "لاباس، الحمد لله. ونتا، كيداير؟"
},
{
"w": "t",
"es": "Bien, gracias a Dios. ¿Todo bien en casa?",
"pr": "bikhir, l-7amdulillah. d-dar kulshi labas?",
"ar": "بخير، الحمد لله. الدار كلشي لاباس؟"
},
{
"w": "o",
"es": "Todo bien, que Dios te guarde.",
"pr": "kulshi mzyan, lla y7fdek.",
"ar": "كلشي مزيان، الله يحفظك."
},
{
"w": "t",
"es": "Gracias a Dios. Venga, ¡adiós!",
"pr": "l-7amdulillah. yallah, bslama!",
"ar": "الحمد لله. يالاه، بسلامة!"
},
{
"w": "o",
"es": "¡Adiós, nos vemos!",
"pr": "bslama, ntshawfu!",
"ar": "بسلامة، نتشاوفو!"
}
]
},
{
